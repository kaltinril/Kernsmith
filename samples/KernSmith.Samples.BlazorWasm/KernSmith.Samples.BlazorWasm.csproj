<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <!-- Override Directory.Build.props multi-targeting; Blazor WASM requires single TFM -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <!-- Version required here because this project opts out of Central Package Management -->
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\KernSmith\KernSmith.csproj" />
    <ProjectReference Include="..\..\src\KernSmith.Rasterizers.StbTrueType\KernSmith.Rasterizers.StbTrueType.csproj" />
    <ProjectReference Include="..\..\src\KernSmith.Rasterizers.Native\KernSmith.Rasterizers.Native.csproj" />
  </ItemGroup>
  <!--
    Determinism check: the page reports the same SHA-256 the Native test project's manifest
    pins (tests/KernSmith.Rasterizers.Native.Tests/Determinism), computed by the same linked
    source, and ships Roboto under wwwroot/fonts so ?backend=native&font=fonts/Roboto-Regular.ttf
    reproduces the manifest case "roboto/32px/grayscale/default" (CI's wasm-publish job runs it).
  -->
  <ItemGroup>
    <Compile Include="..\..\tests\KernSmith.Rasterizers.Native.Tests\Determinism\DeterminismHash.cs" Link="Determinism\DeterminismHash.cs" />
    <Content Include="..\..\tests\KernSmith.Tests\Fixtures\Roboto-Regular.ttf" Link="wwwroot\fonts\Roboto-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
