<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Determinism probe: a console app that generates cases of the Native determinism matrix
    (tests/KernSmith.Rasterizers.Native.Tests/Determinism) and compares their hashes with the
    committed manifest. CI publishes it with PublishAot=true and runs the native binary, which
    is what proves Native's output under NativeAOT matches the JIT's. Runs under the JIT too:

      dotnet run -f net10.0 -\- -\-fixtures tests/KernSmith.Tests/Fixtures
        -\-manifest tests/KernSmith.Rasterizers.Native.Tests/Determinism/manifest.json [-\-case <id prefix>]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <RootNamespace>KernSmith.DeterminismProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KernSmith\KernSmith.csproj" />
    <ProjectReference Include="..\..\src\KernSmith.Rasterizers.Native\KernSmith.Rasterizers.Native.csproj" />
  </ItemGroup>

  <!-- The matrix and the hash are the test project's, compiled in so the three agree by construction. -->
  <ItemGroup>
    <Compile Include="..\KernSmith.Rasterizers.Native.Tests\Determinism\DeterminismHash.cs" Link="Determinism\DeterminismHash.cs" />
    <Compile Include="..\KernSmith.Rasterizers.Native.Tests\Determinism\DeterminismMatrix.cs" Link="Determinism\DeterminismMatrix.cs" />
  </ItemGroup>

</Project>
