# AngelCode Bitmap Font Generator configuration file
# Multi-channel signed distance field (sdfMode=msdf): RGB carry three distances whose
# median is the glyph, alpha is opaque. Same font/size/spread/scale as sdf.bmfc. Only
# backends reporting SupportsMsdf (Native) render it; the rest are skipped.
fileVersion=1

# font settings
fontName=Arial
fontFile=
charSet=0
fontSize=48
aa=1
scaleH=100
useSmoothing=1
isBold=0
isItalic=0
useUnicode=1
disableBoxChars=1
outputInvalidCharGlyph=0
dontIncludeKerningPairs=0
useHinting=1
renderFromOutline=0
useClearType=0
autoFitNumPages=0

# character alignment
paddingDown=0
paddingUp=0
paddingRight=0
paddingLeft=0
spacingHoriz=1
spacingVert=1
useFixedHeight=0
forceZero=0
widthPaddingFactor=0.00

# output file
outWidth=1024
outHeight=1024
outBitDepth=32
fontDescFormat=0
fourChnlPacked=0
textureFormat=png
textureCompression=0
alphaChnl=0
redChnl=0
greenChnl=0
blueChnl=0
invA=0
invR=0
invG=0
invB=0

# outline
outlineThickness=0

# KernSmith extensions
sdfMode=msdf
sdfSpread=6
sdfScale=2

# selected chars
chars=32-126
