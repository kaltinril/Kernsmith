# AngelCode Bitmap Font Generator configuration file
# Outline (red) and shadow (green) routed to their own channels together (#288): the
# packed cell must be the union of the glyph, its outline and its shadow.
fileVersion=1

# font settings
fontName=Georgia
fontFile=
fontSize=48
isBold=0
isItalic=0
useSmoothing=1
aa=1
useHinting=1
scaleH=100
dontIncludeKerningPairs=0

# character alignment
paddingUp=0
paddingDown=0
paddingRight=0
paddingLeft=0
spacingHoriz=1
spacingVert=1
useFixedHeight=0
forceZero=0

# outline
outlineThickness=2

# output file
outWidth=1024
outHeight=1024
outBitDepth=32
fontDescFormat=0
textureFormat=png
fourChnlPacked=0
alphaChnl=0
redChnl=1
greenChnl=5
blueChnl=3

# selected chars
chars=32-126

# output path
outputPath=outline-shadow-channel-text

# kernsmith extensions (issue #167: shadow-only coverage channel)
shadowOffsetX=6
shadowOffsetY=6
shadowBlur=3
autofit=1
