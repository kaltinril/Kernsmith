# AngelCode Bitmap Font Generator configuration file
# LCD with channel packing: FreeType and Native render LCD as RGBA and are refused
# (InvalidOperationException, so no output); GDI, DirectWrite and StbTrueType degrade it
# to grayscale and must pack exactly as channel-packed.bmfc does.
fileVersion=1

# font settings
fontName=Georgia
fontFile=
charSet=0
fontSize=56
aa=1
scaleH=100
useSmoothing=1
isBold=0
isItalic=0
useUnicode=1
disableBoxChars=1
outputInvalidCharGlyph=0
dontIncludeKerningPairs=0
useHinting=1
renderFromOutline=0
useClearType=0
autoFitNumPages=0

# character alignment
paddingDown=0
paddingUp=0
paddingRight=0
paddingLeft=0
spacingHoriz=1
spacingVert=1
useFixedHeight=0
forceZero=0
widthPaddingFactor=0.00

# output file
outWidth=1024
outHeight=1024
outBitDepth=32
fontDescFormat=0
fourChnlPacked=1
textureFormat=png
textureCompression=0
alphaChnl=0
redChnl=0
greenChnl=0
blueChnl=0
invA=0
invR=0
invG=0
invB=0

# outline
outlineThickness=0

# selected chars
chars=32-126

# KernSmith extensions
antiAlias=lcd
