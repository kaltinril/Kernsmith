<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      KernSmith.Ui targets net10.0;net10.0-windows, so this project cannot target net8.0.
      This must override TargetFrameworks (plural) from Directory.Build.props. Setting the
      singular TargetFramework alongside it has no effect, because the plural one wins.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 test projects run as executables -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KernSmith\KernSmith.csproj" />
    <ProjectReference Include="..\..\apps\KernSmith.Ui\KernSmith.Ui.csproj" />
  </ItemGroup>

</Project>
