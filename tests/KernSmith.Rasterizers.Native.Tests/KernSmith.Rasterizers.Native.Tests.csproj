<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 test projects run as executables -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KernSmith\KernSmith.csproj" />
    <ProjectReference Include="..\..\src\KernSmith.Rasterizers.Native\KernSmith.Rasterizers.Native.csproj" />
    <!-- Reference backends used only as comparison baselines: stb_truetype in
         ScanlineRasterizerSsimTests, FreeType in NativeMetricsAgreementTests and the color tests. -->
    <ProjectReference Include="..\..\src\KernSmith.Rasterizers.StbTrueType\KernSmith.Rasterizers.StbTrueType.csproj" />
    <ProjectReference Include="..\..\src\KernSmith.Rasterizers.FreeType\KernSmith.Rasterizers.FreeType.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\KernSmith.Tests\Fixtures\Roboto-Regular.ttf"
          Link="Fixtures\Roboto-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KernSmith.Tests\Fixtures\NotoColorEmoji.ttf"
          Link="Fixtures\NotoColorEmoji.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KernSmith.Tests\Fixtures\Color\BungeeColor-Regular.ttf"
          Link="Fixtures\Color\BungeeColor-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KernSmith.Tests\Fixtures\Color\ReemKufiInk-Regular.ttf"
          Link="Fixtures\Color\ReemKufiInk-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- WOFF2 fixtures and the TTFs they were made from: core decodes WOFF2, these prove
         Native renders the decoded font exactly like the source TTF. -->
    <None Include="..\KernSmith.Tests\Fixtures\Roboto-Regular.woff2;..\KernSmith.Tests\Fixtures\NotoSans-Regular-Latin.ttf;..\KernSmith.Tests\Fixtures\NotoSans-Regular-Latin.woff2;..\KernSmith.Tests\Fixtures\RobotoFlex-Latin.ttf;..\KernSmith.Tests\Fixtures\RobotoFlex-Latin.woff2"
          Link="Fixtures\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KernSmith.Tests\Fixtures\RobotoFlex-Variable.ttf"
          Link="Fixtures\RobotoFlex-Variable.ttf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KernSmith.Tests\Fixtures\DancingScript-Variable.ttf"
          Link="Fixtures\DancingScript-Variable.ttf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
