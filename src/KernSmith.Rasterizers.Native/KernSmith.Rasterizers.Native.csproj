<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- Glyph rendering works, but packaging is pending Jeremy's release decision
         (Phase 179). The publish workflow packs backends by explicit path so this never ships accidentally;
         this flag also keeps a solution-wide `dotnet pack` (see RELEASING.md) from
         producing a package that has not been signed off for release. -->
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>KernSmith.Rasterizers.Native</PackageId>
    <Description>Native KernSmith rasterizer backend. Fully custom, pure C#, cross-platform, with zero external NuGet dependencies. EXPERIMENTAL — renders TrueType ('glyf') and CFF/CFF2 (.otf) outlines, variable fonts, COLR v0/v1 color glyphs, CBDT/sbix color bitmaps, synthetic bold/italic, SDF and MSDF/MTSDF, LCD subpixel and light auto-hinted output; no TrueType bytecode hinting or outline stroke of its own. This project is deliberately not published yet.</Description>
    <PackageProjectUrl>https://github.com/kaltinril/Kernsmith</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Kaltinril (Jeremy Swartwood)</Authors>
    <PackageTags>kernsmith;native;rasterizer;bitmap-font;game-dev;cross-platform;wasm;pure-csharp;sdf</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KernSmith.Rasterizers.Native.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KernSmith\KernSmith.csproj" />
    <!-- Our own PNG decoder, for CBDT/sbix bitmap glyphs (pure managed, like this backend). -->
    <ProjectReference Include="..\KernSmith.Imaging\KernSmith.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
