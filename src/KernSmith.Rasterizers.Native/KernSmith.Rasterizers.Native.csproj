<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- Glyph rendering works as of Phase 165, but packaging is still pending a release
         decision (CFF outlines, synthetic styles and SDF are not implemented yet). The
         publish workflow packs backends by explicit path so this never ships accidentally;
         this flag also keeps a solution-wide `dotnet pack` (see RELEASING.md) from
         producing a package that has not been signed off for release. -->
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>KernSmith.Rasterizers.Native</PackageId>
    <Description>Native KernSmith rasterizer backend. Fully custom, pure C#, cross-platform, with zero external NuGet dependencies. EXPERIMENTAL — renders TrueType ('glyf') outlines only (CFF/OTF fonts are rejected) with no hinting, SDF, outline stroke or synthetic bold/italic, and this project is deliberately not published yet.</Description>
    <PackageProjectUrl>https://github.com/kaltinril/Kernsmith</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Kaltinril (Jeremy Swartwood)</Authors>
    <PackageTags>kernsmith;native;rasterizer;bitmap-font;game-dev;cross-platform;wasm;pure-csharp;sdf</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KernSmith.Rasterizers.Native.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KernSmith\KernSmith.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
